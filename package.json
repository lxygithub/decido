{
  "name": "decido",
  "displayName": "决定吧 · 选择困难症自救工具箱",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort 2>&1 | tee dev.log",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "db:push": "echo '[decido] 纯前端项目，无需数据库'",
    "deploy": "vite build && wrangler deploy",
    "deploy:pages": "vite build && wrangler pages deploy dist --project-name decido"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
